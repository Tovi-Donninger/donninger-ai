{
  "name": "donninger-ai-development",
  "main": "worker.js",
  "compatibility_date": "2026-11-08",
  "vars": {
    "DEV_ADMIN_ENABLED": "true",
    "DEV_ADMIN_EMAIL": "admin@donninger.ai"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/meeting/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "donninger-ai-development-db",
      "database_id": "REPLACE_WITH_DEVELOPMENT_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
