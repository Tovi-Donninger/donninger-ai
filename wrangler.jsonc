{
  "name": "donninger-ai",
  "main": "worker.js",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/meeting/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "donninger-ai-db",
      "database_id": "c3d43b39-c0f5-4022-abbe-4fb855d38357",
      "migrations_dir": "migrations"
    }
  ]
}
